<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/style_cream">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/style_chocolate">

        <ImageView
            android:id="@+id/albumCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/rounded_button"
            android:background="@color/style_light_peachy"
            android:contentDescription="Album Cover"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/albumName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Album Name"
        android:textColor="@color/style_dark_brown"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/arena_rvwak"/>

    <TextView
        android:id="@+id/albumCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 photos"
        android:textColor="@color/style_brown"
        android:textSize="12sp" />

</LinearLayout>
