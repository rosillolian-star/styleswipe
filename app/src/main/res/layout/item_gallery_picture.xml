<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/style_light_peachy">

    <!-- Use a fixed height or wrap_content with minHeight to ensure visibility -->
    <ImageView
        android:id="@+id/pictureThumb"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:background="@color/style_light_peachy"
        android:contentDescription="Outfit Photo"/>
</com.google.android.material.card.MaterialCardView>
